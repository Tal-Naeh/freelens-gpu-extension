{
  "name": "freelens-gpu-extension",
  "version": "0.3.0",
  "description": "Per-pod GPU usage (utilisation, VRAM, power) for Freelens, scraped from dcgm-exporter or any per-process GPU exporter through the apiserver pod-proxy. Zero cluster footprint.",
  "homepage": "https://github.com/Tal-Naeh/freelens-gpu-extension",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tal-Naeh/freelens-gpu-extension.git"
  },
  "bugs": "https://github.com/Tal-Naeh/freelens-gpu-extension/issues",
  "license": "MIT",
  "author": {
    "name": "Tal Naeh",
    "url": "https://github.com/Tal-Naeh"
  },
  "main": "out/main/index.js",
  "renderer": "out/renderer/index.js",
  "files": [
    "out/**/*"
  ],
  "engines": {
    "node": ">= 22.0.0",
    "freelens": "^1.8.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "type:check": "tsc --noEmit -p tsconfig.json --composite false",
    "test": "vitest run",
    "prebuild": "pnpm type:check",
    "build": "electron-vite build",
    "build:production": "VITE_PRESERVE_MODULES=false electron-vite build",
    "pack": "pnpm build:production && pnpm pack",
    "clean": "rm -rf out *.tgz"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@freelensapp/extensions": "^1.10.3",
    "@types/node": "~24.12.4",
    "@types/react": "^17.0.93",
    "@vitejs/plugin-react": "^6.0.3",
    "electron-vite": "^5.0.0",
    "mobx": "6.13.7",
    "mobx-react": "7.6.0",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "typescript": "5.9.3",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "freelens",
    "freelens-extension",
    "lens",
    "lens-extension",
    "kubernetes",
    "gpu",
    "nvidia",
    "dcgm",
    "monitoring"
  ]
}
