{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",

  "entry": ["src/main/index.ts", "src/renderer/index.tsx"],
  "project": ["*.{js,mjs,ts}", "src/**/*.{ts,tsx}"],

  "ignoreBinaries": ["yq"],
  "ignoreDependencies": [
    // Build-only plugins; Knip does not execute the Electron Vite config.
    "@vitejs/plugin-react",
    "@babel/plugin-proposal-decorators",
    // Provided by the Freelens host at runtime (mapped to globals in build/global-externals.js);
    // kept as a devDependency so the react peer range resolves.
    "react-dom"
  ],

  "typescript": {
    "config": ["tsconfig.json"]
  },
  "exclude": ["exports"]
}
